{
  "info": {
    "description": "Uses official preprocessed data. Does not calculate exact multi-step routes.",
    "title": "TFGM official recipe queries",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/items": {
      "get": {
        "operationId": "search_items",
        "parameters": [
          {
            "description": "Exact TFGM version; mismatches are rejected",
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Versioned official data"
          },
          "400": {
            "description": "Invalid request, version mismatch, upstream unavailable or uncached offline resource"
          }
        }
      }
    },
    "/v1/recipe": {
      "get": {
        "operationId": "get_recipe",
        "parameters": [
          {
            "description": "Exact TFGM version; mismatches are rejected",
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Versioned official data"
          },
          "400": {
            "description": "Invalid request, version mismatch, upstream unavailable or uncached offline resource"
          }
        }
      }
    },
    "/v1/recipes": {
      "get": {
        "operationId": "find_recipes_or_uses",
        "parameters": [
          {
            "description": "Exact TFGM version; mismatches are rejected",
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "item",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "default": "output",
              "enum": [
                "input",
                "output"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Versioned official data"
          },
          "400": {
            "description": "Invalid request, version mismatch, upstream unavailable or uncached offline resource"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "recipe_source_status",
        "parameters": [
          {
            "description": "Exact TFGM version; mismatches are rejected",
            "in": "query",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Versioned official data"
          },
          "400": {
            "description": "Invalid request, version mismatch, upstream unavailable or uncached offline resource"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:20260"
    }
  ]
}
